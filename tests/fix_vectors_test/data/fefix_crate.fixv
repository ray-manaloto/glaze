# Test vectors ported from the published `fefix` crate, version 0.7.0 (crates.io, 2021-10-26),
# https://crates.io/crates/fefix, repository https://github.com/ferrumfix/ferrumfix.
# Copyright Filippo Costa (@neysofu) and FerrumFIX contributors (Cargo.toml authors:
# "Filippo Costa @neysofu"). Licensed under MIT OR Apache-2.0 (Cargo.toml `license` field).
# The .crate archive ships no LICENSE-MIT / LICENSE-APACHE / NOTICE file; its only LICENSE file is
# resources/repositories/LICENSE.pdf, which belongs to the bundled FIX Repository data (FIX Trading
# Community), not to fefix, and nothing here is taken from it.
#
# Ported from #[test] functions in src/tagvalue/raw_decoder.rs, src/tagvalue/decoder.rs,
# src/tagvalue/utils.rs and src/fix_values/checksum.rs. No crate code was run; every 9 and 10 below
# was recomputed independently with '|' read as SOH.
#
# '|' is SOH. Upstream unit tests use b'|' as the decoder separator, and their hand-written
# messages carry CheckSums summed over the literal '|' byte (0x7C), e.g. 10=091 for the sample
# NewOrderSingle (glaze, reading '|' as SOH, gets 254). Those vectors are therefore validate
# expect=error here, with a *_soh twin carrying the recomputed checksum. RANDOM_MESSAGES in
# decoder.rs were checked upstream with real SOH, so their checksums are correct.
#
# Skipped: message_with_data_field (value contains '|' and SOH: raw data, unsupported);
# empty_message_is_invalid (empty msg is not expressible reliably in .fixv); checksum edge_cases
# with bytes 128/127 (not representable as UTF-8 text) and the empty-input case; quickcheck
# property tests; config.rs tests (decoder settings, no wire data); edge cases whose framing
# outcome depends on how an "8=" front with an empty or "=" value is treated.

# --- src/tagvalue/raw_decoder.rs ---

id = fefix.crate_raw_sample_parse
source = fefix crate 0.7.0:src/tagvalue/raw_decoder.rs::sample_message_is_valid
kind = parse
msg = 8=FIX.4.2|9=40|35=D|49=AFUNDMGR|56=ABROKER|15=USD|59=0|10=091|
expect = ok
fields = 8=FIX.4.2|9=40|35=D|49=AFUNDMGR|56=ABROKER|15=USD|59=0|10=091
count = 8
note = upstream asserts begin string FIX.4.2 and payload 35=D..59=0 (checksum not verified)

id = fefix.crate_raw_sample_validate
source = fefix crate 0.7.0:src/tagvalue/raw_decoder.rs::sample_message_is_valid
kind = validate
msg = 8=FIX.4.2|9=40|35=D|49=AFUNDMGR|56=ABROKER|15=USD|59=0|10=091|
expect = error
note = BodyLength 40 correct; 091 was summed over literal '|' bytes, with SOH the sum is 254

id = fefix.crate_raw_sample_soh_validate
source = fefix crate 0.7.0:src/tagvalue/raw_decoder.rs::sample_message_is_valid
kind = validate
msg = 8=FIX.4.2|9=40|35=D|49=AFUNDMGR|56=ABROKER|15=USD|59=0|10=254|
expect = ok
note = same message with CheckSum recomputed over SOH separators

id = fefix.crate_raw_sample_checksum
source = fefix crate 0.7.0:src/tagvalue/raw_decoder.rs::sample_message_is_valid
kind = checksum
bytes = 8=FIX.4.2|9=40|35=D|49=AFUNDMGR|56=ABROKER|15=USD|59=0|
value = 254

