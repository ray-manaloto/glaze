id = spec.cks_bytes_logout
source = spec
kind = checksum
bytes = 8=FIX.4.4|9=58|35=5|49=NODEA|56=NODEB|34=90|52=20261105-17:00:01|58=bye|
value = 252
note = checksum over a Logout prefix (sum mod 256)

id = spec.cks_bytes_soh_only
source = spec
kind = checksum
bytes = |
value = 1
note = checksum of a single SOH byte is 1

id = spec.cks_bytes_wrap_exact
source = spec
kind = checksum
bytes = @@@@
value = 0
note = four 0x40 bytes sum to 256, which wraps to 0

