msg = 8=FIX.4.2|9=16|35=D|5001=AAAAA|10=048|
expect = ok
note = encoded message with BodyLength 16 and zero-padded CheckSum 048; verified

id = simplefix.basic_fix_message_valid
source = da4089/simplefix:test/test_parser.py::test_basic_fix_message
kind = validate
msg = 8=FIX.4.2|9=10|35=D|29=A|10=203|
expect = ok
note = encode() output of 8=FIX.4.2,35=D,29=A (computed with python3, test builds it via FixMessage)

id = simplefix.partial_string_complete
source = da4089/simplefix:test/test_parser.py::test_parse_partial_string
kind = validate
msg = 8=FIX.4.2|9=5|35=0|10=161|
expect = ok
note = message reassembled from two fragments; 9=5 and 10=161 verified

id = simplefix.embedded_equals_fixed
source = da4089/simplefix:test/test_parser.py::test_embedded_equals_96_no_95
kind = validate
msg = 8=FIX.4.2|9=101|35=A|52=20171213-01:41:08.063|49=HelloWorld|56=1234|34=1|96=ABC=DE|98=0|108=30|554=HelloWorld|8013=Y|10=088|
expect = ok
note = Logon with '=' inside value 96; simplefix's loose 9=169/10=166 fixed to 9=101/10=088

# ---- frame ----

