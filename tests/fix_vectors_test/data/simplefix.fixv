note = both fragments appended form one complete message

id = simplefix.get_buffer_after_message
source = da4089/simplefix:test/test_parser.py::test_get_buffer
kind = frame
stream = 8=FIX.4.2|9=5|35=0|10=161|
frame_len = 26
note = whole buffer consumed by the message (get_buffer() returns empty afterwards)

id = simplefix.empty_value_frame
source = da4089/simplefix:test/test_parser.py::test_empty_value
kind = frame
stream = 8=FIX.4.2|9=9|35=D|29=|10=098|
frame_len = 30
note = message with empty value 29= frames normally; original 9=9 and 10=098 verified correct

id = simplefix.leading_junk_pairs
source = da4089/simplefix:test/test_parser.py::test_leading_junk_pairs
kind = frame
stream = 1=2|3=4|8=FIX.4.2|9=5|35=0|10=161|
frame_len = error
note = junk fields before 8= are skipped; frame_len is the length of the message itself; simplefix skips junk before 8=; glz::fix::frame does not skip and reports frame_error (docs/fix/api.md, Q1 settled by fix/core)

id = simplefix.junk_pairs_only
source = da4089/simplefix:test/test_parser.py::test_junk_pairs
kind = frame
stream = 1=2|3=4|5=6|
frame_len = error
note = stream of junk fields with no 8= gives no message; simplefix skips junk and waits; glz::fix::frame reports frame_error instead (docs/fix/api.md)

id = simplefix.raw_data_packet_boundary_first
source = da4089/simplefix:test/test_parser.py::test_raw_data_ending_on_packet_boundary
kind = frame
stream = 8=FIX.4.2|9=84|35=A|52=20171213-01:41:08.063|49=HelloWorld|56=1234|34=1|95=6|96=ABC=DE
frame_len = 0
note = first packet ends right after raw data 96 (before its SOH): incomplete; 9 fixed from loose 169 to 84

id = simplefix.raw_data_packet_boundary_full
source = da4089/simplefix:test/test_parser.py::test_raw_data_ending_on_packet_boundary
kind = frame
stream = 8=FIX.4.2|9=84|35=A|52=20171213-01:41:08.063|49=HelloWorld|56=1234|34=1|95=6|96=ABC=DE|98=0|108=30|10=217|
frame_len = 106
note = both packets: complete message with 95=6/96=ABC=DE; loose 9=169/10=166 fixed to 9=84/10=217

