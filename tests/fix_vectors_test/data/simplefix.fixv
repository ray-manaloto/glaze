id = simplefix.embedded_equals
source = da4089/simplefix:test/test_parser.py::test_embedded_equals_96_no_95
kind = parse
msg = 8=FIX.4.2|9=169|35=A|52=20171213-01:41:08.063|49=HelloWorld|56=1234|34=1|96=ABC=DE|98=0|108=30|554=HelloWorld|8013=Y|10=166|
expect = ok
fields = 8=FIX.4.2|9=169|35=A|52=20171213-01:41:08.063|49=HelloWorld|56=1234|34=1|96=ABC=DE|98=0|108=30|554=HelloWorld|8013=Y|10=166|
note = only the first '=' splits tag from value: 96=ABC=DE; original (loose) 9 and 10 kept, scan only

id = simplefix.cme_secdef_no_begin_string
source = da4089/simplefix:test/test_parser.py::test_cme_secdef
kind = parse
msg = 35=d|5799=00000000|980=A|779=20180408160519000025|1180=310|1300=64|462=5|207=XCME|1151=ES|6937=ES|55=ESM9|48=736|22=8|167=FUT|461=FFIXSX|200=201906|15=USD|1142=F|562=1|1140=3000|969=25.0000000|9787=0.0100000|996=IPNT|1147=50.0000000|1150=263175.0000000|731=00000111|5796=20180406|1149=275950.0000000|1148=249950.0000000|1143=600.0000000|1146=12.5000000|9779=N|864=2|865=5|1145=20180316133000000000|865=7|1145=20190621133000000000|1141=1|1022=GBX|264=10|870=1|871=24|872=00000000000001000010000000001111|1234=0|
expect = ok
count = 44
note = first record of CME secdef file: no 8/9/10, repeated tags 865/1145; tag=value scan succeeds

id = simplefix.string_with_equals
