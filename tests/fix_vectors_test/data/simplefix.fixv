kind = parse
msg = 20001=first|20002=second|20000=third|
expect = ok
fields = 20001=first|20002=second|20000=third|
note = raw-mode encoding output; field order preserved as on the wire

id = simplefix.str_values
source = da4089/simplefix:test/test_message.py::test_str
kind = parse
msg = 1=1|2=foo|3=bar|4=3.1415679|
expect = ok
fields = 1=1|2=foo|3=bar|4=3.1415679|
note = str(msg) output '1=1|2=foo|3=bar|4=3.1415679' with SOH terminator added on last field

# ---- validate ----

id = simplefix.set_session_version
