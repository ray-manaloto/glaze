kind = parse
msg = FIX.4.2|
expect = error
note = field with no '=' is rejected (ValueError)

id = simplefix.string_with_bad_tag
source = da4089/simplefix:test/test_message.py::test_string_with_bad_tag
kind = parse
msg = foo=bar|
expect = error
note = non-numeric tag 'foo' is rejected (ValueError)

id = simplefix.header_field_order
