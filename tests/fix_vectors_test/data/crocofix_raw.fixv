id = crocofix.raw.data_field_parse
source = GaryHughes/crocofix:libcrocofix_tests/message_tests.cpp::Message
kind = parse
msg = 8=FIX.4.4|9=167|35=D|49=INITIATOR|56=ACCEPTOR|34=2752|52=20200114-08:13:20.041|11=61|70=60|100=AUTO|55=BHP.AX|54=1|60=20200114-08:12:59.397|38=10000|40=2|44=20|59=1|93=20|89=ABCDEF|ABCDEFABC|DEF|10=220|
expect = ok
count = 20
note = SECTION "decode a message containing a data field": Signature(89) of 20 bytes with two SOH inside

id = crocofix.raw.data_field_validate
source = GaryHughes/crocofix:libcrocofix_tests/message_tests.cpp::Message
kind = validate
msg = 8=FIX.4.4|9=167|35=D|49=INITIATOR|56=ACCEPTOR|34=2752|52=20200114-08:13:20.041|11=61|70=60|100=AUTO|55=BHP.AX|54=1|60=20200114-08:12:59.397|38=10000|40=2|44=20|59=1|93=20|89=ABCDEF|ABCDEFABC|DEF|10=220|
expect = error
note = same; upstream 9=167 is wrong (body is 179 bytes) and crocofix does not check it

