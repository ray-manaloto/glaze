id = crocofix.raw.data_field_no_length_parse
source = GaryHughes/crocofix:libcrocofix_tests/message_tests.cpp::Message
kind = parse
msg = 8=FIX.4.4|9=149|35=D|89=123|49=INITIATOR|56=ACCEPTOR|34=2752|52=20200114-08:13:20.041|11=61|70=60|100=AUTO|55=BHP.AX|54=1|60=20200114-08:12:59.397|38=10000|40=2|44=20|59=1|10=021|
expect = ok
count = 19
note = SECTION "data field that has no preceeding size field": crocofix rejects it; a plain scanner reads 89=123 as an ordinary field. Ported as the scanner outcome

id = crocofix.raw.data_field_no_trailing_soh_parse
source = GaryHughes/crocofix:libcrocofix_tests/message_tests.cpp::Message
kind = parse
msg = 8=FIX.4.4|9=149|35=D|93=3|89=AAA49=INITIATOR|56=ACCEPTOR|34=2752|52=20200114-08:13:20.041|11=61|70=60|100=AUTO|55=BHP.AX|54=1|60=20200114-08:12:59.397|38=10000|40=2|44=20|59=1|10=021|
expect = error
note = SECTION "data field that does not have a traling field separator": 93=3 then 89=AAA is not followed by SOH
