# '|' is SOH, including inside raw values.

id = simplefix.raw_data_parse
source = da4089/simplefix:test/test_parser.py::test_raw_data
kind = parse
msg = 8=FIX.4.2|9=40|35=D|95=8|96=raw|data|20000=private tag|10=225|
expect = ok
fields = 8=FIX.4.2|9=40|35=D|95=8|96=raw|data|20000=private tag|10=225|
note = RawData(96) holds an SOH; RawDataLength(95)=8 tells the scanner to take 8 bytes

id = simplefix.raw_data_validate
source = da4089/simplefix:test/test_parser.py::test_raw_data
