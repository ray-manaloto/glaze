msg = 8=FIX.4.2|9=40|35=D|95=8|96=raw|data|20000=private tag|10=225|
expect = ok
note = same message with 9 and 10 computed for SOH; BodyLength counts the raw bytes

id = simplefix.raw_data_frame
source = da4089/simplefix:test/test_parser.py::test_raw_data
kind = frame
stream = 8=FIX.4.2|9=40|35=D|95=8|96=raw|data|20000=private tag|10=225|8=FIX.4.2|9=
frame_len = 62
note = framing trusts 9, so the SOH inside 96 does not end the message early

id = simplefix.raw_data_all_soh_parse
