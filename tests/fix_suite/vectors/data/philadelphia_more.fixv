# More test vectors ported from Philadelphia (https://github.com/paritytrading/philadelphia).
# Copyright 2015 Philadelphia authors. Licensed under the Apache License, Version 2.0
# (see licenses/philadelphia-LICENSE.txt). Upstream has no NOTICE file.
# Complements philadelphia.fixv: the remaining exact wire messages asserted in FIXInitiatorTest
# (Reject, ResendRequest, SequenceReset-GapFill, Logout, Heartbeat variants) and the bare message
# bodies the tests feed to the initiator. '|' is SOH. Every validate vector's BodyLength and
# CheckSum and every frame length was recomputed with python3.
# Not ported: upstream has no FIXAcceptorTest in this checkout; FIXInitiatorTest messages that
# the existing file already covers are not repeated.

id = philadelphia.test_request_heartbeat_validate
source = paritytrading/philadelphia:libraries/core/src/test/java/com/paritytrading/philadelphia/FIXInitiatorTest.java::testRequest
kind = validate
msg = 8=FIX.4.2|9=60|35=0|49=initiator|56=acceptor|34=1|52=19700101-00:00:32.500|10=225|
expect = ok
note = Heartbeat at 32.500 s sent before the TestRequest; SendingTime with non-zero millis, CheckSum 225

id = philadelphia.test_request_two_message_frame
source = paritytrading/philadelphia:libraries/core/src/test/java/com/paritytrading/philadelphia/FIXInitiatorTest.java::testRequest
kind = frame
stream = 8=FIX.4.2|9=60|35=0|49=initiator|56=acceptor|34=1|52=19700101-00:00:32.500|10=225|8=FIX.4.2|9=86|35=1|49=initiator|56=acceptor|34=2|52=19700101-00:00:35.000|112=19700101-00:00:35.000|10=213|
frame_len = 82
note = Heartbeat followed by TestRequest on the wire; first frame is the 82-byte Heartbeat

